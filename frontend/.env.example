# Frontend Environment Configuration for Production / Vercel

# 1. When your Spring Boot Backend is hosted on Render, Railway, or AWS:
# Replace the URL below with your actual deployed backend URL (HTTPS is recommended).
# Example: https://delivery-optimizer-backend.onrender.com
VITE_API_URL=https://delivery-optimizer-backend.onrender.com

# 2. WebSocket endpoint (uses the same backend host with /ws):
# Example: https://delivery-optimizer-backend.onrender.com/ws
VITE_WS_URL=https://delivery-optimizer-backend.onrender.com/ws
